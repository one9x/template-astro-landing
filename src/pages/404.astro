---
// Served for any path that is not a file, by the `--error 404:/404.html`
// mapping in the deploy workflow.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <div class="container">
    <div class="prose">
      <p class="eyebrow">404</p>
      <h1>This page doesn't exist.</h1>
      <p>The link may be old, or the address mistyped.</p>
      <p class="actions"><a class="btn btn-ghost" href="/">Back to the home page</a></p>
    </div>
  </div>
</Layout>
