---
// Every page's <head>, header and footer. The product name and tagline live in
// src/site.ts so a rename is one edit, not a search through every page.
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** The full nav (section links) is for the one-page landing only. */
  nav?: boolean;
}

const { title, description = SITE.description, nav = false } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    {/* TEMPLATE NOTE — delete this <aside> once the page is yours. */}
    <aside class="template-note">
      <p>
        A template: {SITE.name} is a placeholder product.{' '}
        <a href="https://github.com/one9x/template-astro-landing/generate">Use this template&nbsp;&rarr;</a>
      </p>
    </aside>

    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/" aria-label={`${SITE.name} home`}>
          <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="9" fill="var(--accent)" />
            <path d="M9 21.5 16 9l7 12.5M11.6 17h8.8" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {SITE.name}
        </a>
        {
          nav && (
            <nav aria-label="Sections">
              <a href="#features">Features</a>
              <a href="#how">How it works</a>
              <a href="#faq">FAQ</a>
            </nav>
          )
        }
        <a class="btn btn-small" href={nav ? '#waitlist' : '/#waitlist'}>Join the waitlist</a>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="container foot">
        <p>&copy; {new Date().getFullYear()} {SITE.name}</p>
        <nav aria-label="Footer">
          <a href="/privacy">Privacy</a>
          <a href="/#faq">FAQ</a>
        </nav>
        {/* One line, safe to delete. */}
        <p class="credit">Deployed on <a href="https://one9x.com/templates">One9x Pages</a></p>
      </div>
    </footer>

    <style is:global>
*,*::before,*::after{box-sizing:border-box}
:root{
  /* The one line to change: every button, link and highlight derives from it. */
  --accent:#5847E0;

  --bg:#FBFBFC; --surface:#FFFFFF; --sunk:#F2F2F6; --text:#15151C;
  --muted:#5A5A6E; --line:#E3E3EA;
  --link:var(--accent);
  --tint:color-mix(in oklab, var(--accent) 10%, var(--surface));
  --radius:14px;
  --shadow:0 1px 2px rgb(16 16 32 / .05), 0 8px 24px -12px rgb(16 16 32 / .12);
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#0E0E13; --surface:#16161D; --sunk:#1C1C25; --text:#EDEDF3;
    --muted:#A3A3B5; --line:#2A2A36;
    --link:color-mix(in oklab, var(--accent), white 45%);
    --tint:color-mix(in oklab, var(--accent) 18%, var(--surface));
    --shadow:0 1px 2px rgb(0 0 0 / .4), 0 12px 32px -16px rgb(0 0 0 / .6);
  }
}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--bg);color:var(--text);
  font:17px/1.6 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
a{color:var(--link);text-underline-offset:3px}
:focus-visible{outline:3px solid var(--link);outline-offset:2px;border-radius:6px}
img,svg{display:block;max-width:100%}
h1,h2,h3{line-height:1.12;letter-spacing:-.022em;text-wrap:balance;margin:0}
p{margin:0}
.container{width:min(72rem,100% - 2.5rem);margin-inline:auto}

.skip{position:absolute;left:-999px;top:.5rem;background:var(--surface);color:var(--text);
  padding:.5rem .9rem;border-radius:8px;z-index:20}
.skip:focus{left:.5rem}

.template-note{background:var(--text);color:var(--bg);font-size:.85rem;text-align:center;padding:.5rem 1rem}
.template-note a{color:inherit;font-weight:600;white-space:nowrap}

.site-header{position:sticky;top:0;z-index:10;background:color-mix(in oklab, var(--bg) 82%, transparent);
  backdrop-filter:saturate(1.4) blur(10px);-webkit-backdrop-filter:saturate(1.4) blur(10px);
  border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;gap:1.5rem;height:4rem}
.brand{display:flex;align-items:center;gap:.6rem;font-weight:700;font-size:1.1rem;
  color:var(--text);text-decoration:none;letter-spacing:-.01em}
.mark{width:28px;height:28px}
.bar nav{display:flex;gap:1.5rem;margin-left:auto}
.bar nav a{color:var(--muted);text-decoration:none;font-size:.95rem}
.bar nav a:hover{color:var(--text)}
.bar > .btn{margin-left:auto}
.bar nav + .btn{margin-left:0}
@media (max-width:720px){.bar nav{display:none}.bar nav + .btn{margin-left:auto}}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;
  background:var(--accent);color:#fff;border:0;border-radius:10px;
  padding:.8rem 1.25rem;font-family:inherit;font-size:1rem;font-weight:600;line-height:1.2;text-decoration:none;cursor:pointer;
  transition:filter .15s,transform .15s}
.btn:hover{filter:brightness(1.08)}
.btn:active{transform:translateY(1px)}
.btn-small{padding:.55rem .95rem;font-size:.9rem}
.btn-ghost{background:transparent;color:var(--text);box-shadow:inset 0 0 0 1px var(--line)}
.btn-ghost:hover{background:var(--sunk);filter:none}

.eyebrow{display:inline-flex;align-items:center;gap:.5rem;font-size:.82rem;font-weight:600;
  color:var(--link);background:var(--tint);padding:.3rem .75rem;border-radius:999px}
.section{padding:clamp(4rem,10vw,7rem) 0}
.section-head{max-width:40rem;margin-bottom:3rem}
.section-head h2{font-size:clamp(1.8rem,4vw,2.6rem)}
.section-head p{color:var(--muted);margin-top:1rem;font-size:1.1rem}

.prose{max-width:42rem;padding:clamp(3rem,8vw,5rem) 0}
.prose h1{font-size:clamp(2rem,5vw,2.8rem);margin-top:1.25rem}
.prose .actions{margin-top:2rem}
.prose h2{font-size:1.3rem;margin:2.5rem 0 .75rem}
.prose p:not(.eyebrow),.prose li{color:var(--muted)}
.prose p{margin-top:1rem}
.prose ul{padding-left:1.25rem}

.site-footer{border-top:1px solid var(--line);padding:2rem 0;font-size:.9rem;color:var(--muted)}
.foot{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem 1.5rem}
.foot nav{display:flex;gap:1.25rem}
.foot nav a{color:var(--muted)}
.foot .credit{margin-left:auto}
.foot .credit a{color:var(--muted)}
@media (max-width:560px){.foot .credit{margin-left:0;width:100%}}
    </style>
  </body>
</html>
